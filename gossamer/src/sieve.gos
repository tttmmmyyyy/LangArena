use bench::Bench
use config::Config

pub struct Sieve {
    limit: i64
    result: u32
}

impl Sieve {
    pub fn new(cfg: Config) -> Sieve {
        Sieve { limit: cfg.int("Etc::Sieve", "limit"), result: 0 }
    }
}

impl Bench for Sieve {
    fn run(&mut self, iteration_id: i64) {
        let limit = self.limit
        let mut primes: Vec<u8> = #[1; limit + 1]
        primes[0] = 0
        primes[1] = 0

        let sqrt_limit = (limit as f64).sqrt() as i64
        for p in 2..=sqrt_limit {
            if primes[p] == 1 {
                let mut multiple = p * p
                while multiple <= limit {
                    primes[multiple] = 0
                    multiple += p
                }
            }
        }

        let mut last_prime = 2
        let mut count = 1
        let mut n = 3
        while n <= limit {
            if primes[n] == 1 {
                last_prime = n
                count += 1
            }
            n += 2
        }

        self.result +%= (last_prime + count) as u32
    }

    fn checksum(&self) -> u32 { self.result }
}
