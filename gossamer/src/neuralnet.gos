use std::math
use bench::Bench
use config::Config
use helper

const INPUT_00: [f64; 2] = [0.0, 0.0]
const INPUT_01: [f64; 2] = [0.0, 1.0]
const INPUT_10: [f64; 2] = [1.0, 0.0]
const INPUT_11: [f64; 2] = [1.0, 1.0]
const TARGET_0: [f64; 1] = [0.0]
const TARGET_1: [f64; 1] = [1.0]

struct Synapse {
    weight: f64
    prev_weight: f64
    source_neuron: i64
    dest_neuron: i64
}

impl Synapse {
    fn new(source_neuron: i64, dest_neuron: i64, rng: &mut helper::Rng) -> Synapse {
        let w = rng.next_float(1.0) * 2.0 - 1.0
        Synapse { weight: w, prev_weight: w, source_neuron: source_neuron, dest_neuron: dest_neuron }
    }
}

struct Neuron {
    threshold: f64
    prev_threshold: f64
    output: f64
    error: f64
    synapses_in: Vec<i64>
    synapses_out: Vec<i64>
}

impl Neuron {
    const LEARNING_RATE: f64 = 1.0
    const MOMENTUM: f64 = 0.3

    fn new(rng: &mut helper::Rng) -> Neuron {
        let t = rng.next_float(1.0) * 2.0 - 1.0
        Neuron {
            threshold: t
            prev_threshold: t
            output: 0.0
            error: 0.0
            synapses_in: #[]
            synapses_out: #[]
        }
    }

    fn derivative(&self) -> f64 { self.output * (1.0 - self.output) }

    fn calculate_output(&mut self, sources: [Neuron], synapses: [Synapse]) {
        let mut activation = 0.0
        for synapse_idx in self.synapses_in {
            let synapse = synapses[synapse_idx]
            activation += synapse.weight * sources[synapse.source_neuron].output
        }
        activation -= self.threshold
        self.output = 1.0 / (1.0 + math::exp(-activation))
    }

    fn update_weights(&mut self, rate: f64, sources: [Neuron], synapses: &mut [Synapse]) {
        for synapse_idx in self.synapses_in {
            let source_output = sources[synapses[synapse_idx].source_neuron].output
            let temp_weight = synapses[synapse_idx].weight
            synapses[synapse_idx].weight += (rate * Neuron::LEARNING_RATE * self.error * source_output) +
                (Neuron::MOMENTUM * (synapses[synapse_idx].weight - synapses[synapse_idx].prev_weight))
            synapses[synapse_idx].prev_weight = temp_weight
        }

        let temp_threshold = self.threshold
        self.threshold += (rate * Neuron::LEARNING_RATE * self.error * -1.0) +
            (Neuron::MOMENTUM * (self.threshold - self.prev_threshold))
        self.prev_threshold = temp_threshold
    }
}

struct NeuralNetwork {
    input_layer: Vec<Neuron>
    hidden_layer: Vec<Neuron>
    output_layer: Vec<Neuron>
    synapses: Vec<Synapse>
}

impl NeuralNetwork {
    fn new(inputs: i64, hidden: i64, outputs: i64, rng: &mut helper::Rng) -> NeuralNetwork {
        let mut input_layer: Vec<Neuron> = #[]
        for _ in 0..inputs { input_layer.push(Neuron::new(rng)) }
        let mut hidden_layer: Vec<Neuron> = #[]
        for _ in 0..hidden { hidden_layer.push(Neuron::new(rng)) }
        let mut output_layer: Vec<Neuron> = #[]
        for _ in 0..outputs { output_layer.push(Neuron::new(rng)) }
        let mut synapses: Vec<Synapse> = #[]

        NeuralNetwork::connect(&mut input_layer, &mut hidden_layer, &mut synapses, rng)
        NeuralNetwork::connect(&mut hidden_layer, &mut output_layer, &mut synapses, rng)

        NeuralNetwork {
            input_layer: input_layer
            hidden_layer: hidden_layer
            output_layer: output_layer
            synapses: synapses
        }
    }

    fn connect(
        sources: &mut [Neuron]
        destinations: &mut [Neuron]
        synapses: &mut Vec<Synapse>
        rng: &mut helper::Rng
    ) {
        for source_idx in 0..sources.len() {
            for dest_idx in 0..destinations.len() {
                let synapse_idx = synapses.len()
                synapses.push(Synapse::new(source_idx, dest_idx, rng))
                sources[source_idx].synapses_out.push(synapse_idx)
                destinations[dest_idx].synapses_in.push(synapse_idx)
            }
        }
    }

    fn train(&mut self, inputs: [f64], targets: [f64]) {
        self.feed_forward(inputs)

        let rate = 0.3

        for i in 0..self.output_layer.len() {
            self.output_layer[i].error = (targets[i] - self.output_layer[i].output) *
                self.output_layer[i].derivative()
            self.output_layer[i].update_weights(rate, self.hidden_layer, &mut self.synapses)
        }

        for i in 0..self.hidden_layer.len() {
            let mut sum = 0.0
            for synapse_idx in self.hidden_layer[i].synapses_out {
                let synapse = self.synapses[synapse_idx]
                sum += synapse.prev_weight * self.output_layer[synapse.dest_neuron].error
            }
            self.hidden_layer[i].error = sum * self.hidden_layer[i].derivative()
            self.hidden_layer[i].update_weights(rate, self.input_layer, &mut self.synapses)
        }
    }

    fn feed_forward(&mut self, inputs: [f64]) {
        for i in 0..self.input_layer.len() { self.input_layer[i].output = inputs[i] }

        for i in 0..self.hidden_layer.len() {
            self.hidden_layer[i].calculate_output(self.input_layer, self.synapses)
        }

        for i in 0..self.output_layer.len() {
            self.output_layer[i].calculate_output(self.hidden_layer, self.synapses)
        }
    }

    fn current_outputs(&self) -> Vec<f64> { self.output_layer.map(|neuron| neuron.output) }
}

pub struct NeuralNet {
    xor_net: NeuralNetwork
    rng: helper::Rng
}

impl NeuralNet {
    pub fn new(cfg: Config) -> NeuralNet {
        let mut rng = helper::Rng::new()
        NeuralNet { xor_net: NeuralNetwork::new(0, 0, 0, &mut rng), rng: rng }
    }
}

impl Bench for NeuralNet {
    fn prepare(&mut self) { self.xor_net = NeuralNetwork::new(2, 10, 1, &mut self.rng) }

    fn run(&mut self, iteration_id: i64) {
        for _ in 0..1000 {
            self.xor_net.train(INPUT_00, TARGET_0)
            self.xor_net.train(INPUT_10, TARGET_1)
            self.xor_net.train(INPUT_01, TARGET_1)
            self.xor_net.train(INPUT_11, TARGET_0)
        }
    }

    fn checksum(&self) -> u32 {
        let mut net_copy = self.xor_net

        net_copy.feed_forward([0.0, 0.0])
        let outputs1 = net_copy.current_outputs()

        net_copy.feed_forward([0.0, 1.0])
        let outputs2 = net_copy.current_outputs()

        net_copy.feed_forward([1.0, 0.0])
        let outputs3 = net_copy.current_outputs()

        net_copy.feed_forward([1.0, 1.0])
        let outputs4 = net_copy.current_outputs()

        let mut all_outputs: Vec<f64> = #[]
        all_outputs.extend_from_slice(outputs1)
        all_outputs.extend_from_slice(outputs2)
        all_outputs.extend_from_slice(outputs3)
        all_outputs.extend_from_slice(outputs4)

        let sum = all_outputs.sum()
        helper::checksum_f64(sum)
    }
}
