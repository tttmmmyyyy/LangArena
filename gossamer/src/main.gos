use std::{env, fs, io, process, time}
use bench::Bench
use config::Config
use base64bench::{Base64Decode, Base64Encode}
use binarytrees::{BinarytreesArena, BinarytreesObj}
use brainfuck::{BrainfuckArray, BrainfuckRecursion}
use bufferhash::{BufferHashCrc32, BufferHashSha256}
use cachesim::CacheSimulation
use calculator::{CalculatorAst, CalculatorInterpreter}
use clbg::{Fannkuchredux, Mandelbrot, Nbody, Spectralnorm}
use compress::{ArithDecode, ArithEncode, BwtDecode, BwtEncode, HuffDecode, HuffEncode, LzwDecode, LzwEncode}
use csvbench::CsvParse
use distance::{Jaro, NGram}
use gameoflife::GameOfLife
use graph::{GraphAStar, GraphBfs, GraphDfs}
use jsonbench::{JsonGenerate, JsonParseDom, JsonParseMapping}
use logparser::LogParser
use matmul::{MatmulSingle, MatmulT16, MatmulT4, MatmulT8}
use maze::{MazeAStar, MazeBfs, MazeGenerator}
use neuralnet::NeuralNet
use raytracer::TextRaytracer
use sieve::Sieve
use sorts::{SortMerge, SortQuick, SortSelf}
use template::{TemplateParse, TemplateRegex}
use words::Words

fn execute<B: Bench>(mut b: B, cfg: Config, name: String) -> (f64, bool) {
    b.prepare()
    b.warmup(cfg.warmup_iterations(name))

    print("{}: ", name)
    io::stdout().flush()

    let start = time::monotonic_nanos()
    for i in 0..cfg.iterations(name) { b.run(i) }
    let elapsed = (time::monotonic_nanos() - start) as f64 / 1_000_000_000.0

    let actual = b.checksum()
    let expected = cfg.int(name, "checksum") as u32
    if actual == expected {
        print("OK ")
    } else {
        print("ERR[actual={}, expected={}] ", actual, expected)
    }
    println("in {:.3}s", elapsed)
    (elapsed, actual == expected)
}

fn dispatch(cfg: Config, name: String) -> Option<(f64, bool)> {
    match name {
        "Binarytrees::Obj" => Some(execute(BinarytreesObj::new(cfg), cfg, name))
        "Binarytrees::Arena" => Some(execute(BinarytreesArena::new(cfg), cfg, name))
        "Brainfuck::Array" => Some(execute(BrainfuckArray::new(cfg), cfg, name))
        "Brainfuck::Recursion" => Some(execute(BrainfuckRecursion::new(cfg), cfg, name))
        "Matmul::Single" => Some(execute(MatmulSingle::new(cfg), cfg, name))
        "Matmul::T4" => Some(execute(MatmulT4::new(cfg), cfg, name))
        "Matmul::T8" => Some(execute(MatmulT8::new(cfg), cfg, name))
        "Matmul::T16" => Some(execute(MatmulT16::new(cfg), cfg, name))
        "Base64::Encode" => Some(execute(Base64Encode::new(cfg), cfg, name))
        "Base64::Decode" => Some(execute(Base64Decode::new(cfg), cfg, name))
        "Json::Generate" => Some(execute(JsonGenerate::new(cfg), cfg, name))
        "Json::ParseDom" => Some(execute(JsonParseDom::new(cfg), cfg, name))
        "Json::ParseMapping" => Some(execute(JsonParseMapping::new(cfg), cfg, name))
        "CSV::Parse" => Some(execute(CsvParse::new(cfg), cfg, name))
        "Etc::Sieve" => Some(execute(Sieve::new(cfg), cfg, name))
        "Etc::TextRaytracer" => Some(execute(TextRaytracer::new(cfg), cfg, name))
        "Etc::NeuralNet" => Some(execute(NeuralNet::new(cfg), cfg, name))
        "Etc::CacheSimulation" => Some(execute(CacheSimulation::new(cfg), cfg, name))
        "Etc::GameOfLife" => Some(execute(GameOfLife::new(cfg), cfg, name))
        "Etc::Words" => Some(execute(Words::new(cfg), cfg, name))
        "Etc::LogParser" => Some(execute(LogParser::new(cfg), cfg, name))
        "Template::Regex" => Some(execute(TemplateRegex::new(cfg), cfg, name))
        "Template::Parse" => Some(execute(TemplateParse::new(cfg), cfg, name))
        "Sort::Quick" => Some(execute(SortQuick::new(cfg), cfg, name))
        "Sort::Merge" => Some(execute(SortMerge::new(cfg), cfg, name))
        "Sort::Self" => Some(execute(SortSelf::new(cfg), cfg, name))
        "Graph::BFS" => Some(execute(GraphBfs::new(cfg), cfg, name))
        "Graph::DFS" => Some(execute(GraphDfs::new(cfg), cfg, name))
        "Graph::AStar" => Some(execute(GraphAStar::new(cfg), cfg, name))
        "Hash::SHA256" => Some(execute(BufferHashSha256::new(cfg), cfg, name))
        "Hash::CRC32" => Some(execute(BufferHashCrc32::new(cfg), cfg, name))
        "Calculator::Ast" => Some(execute(CalculatorAst::new(cfg), cfg, name))
        "Calculator::Interpreter" => Some(execute(CalculatorInterpreter::new(cfg), cfg, name))
        "Maze::Generator" => Some(execute(MazeGenerator::new(cfg), cfg, name))
        "Maze::BFS" => Some(execute(MazeBfs::new(cfg), cfg, name))
        "Maze::AStar" => Some(execute(MazeAStar::new(cfg), cfg, name))
        "CLBG::Fannkuchredux" => Some(execute(Fannkuchredux::new(cfg), cfg, name))
        "CLBG::Mandelbrot" => Some(execute(Mandelbrot::new(cfg), cfg, name))
        "CLBG::Nbody" => Some(execute(Nbody::new(cfg), cfg, name))
        "CLBG::Spectralnorm" => Some(execute(Spectralnorm::new(cfg), cfg, name))
        "Compress::BWTEncode" => Some(execute(BwtEncode::new(cfg), cfg, name))
        "Compress::BWTDecode" => Some(execute(BwtDecode::new(cfg), cfg, name))
        "Compress::HuffEncode" => Some(execute(HuffEncode::new(cfg), cfg, name))
        "Compress::HuffDecode" => Some(execute(HuffDecode::new(cfg), cfg, name))
        "Compress::ArithEncode" => Some(execute(ArithEncode::new(cfg), cfg, name))
        "Compress::ArithDecode" => Some(execute(ArithDecode::new(cfg), cfg, name))
        "Compress::LZWEncode" => Some(execute(LzwEncode::new(cfg), cfg, name))
        "Compress::LZWDecode" => Some(execute(LzwDecode::new(cfg), cfg, name))
        "Distance::Jaro" => Some(execute(Jaro::new(cfg), cfg, name))
        "Distance::NGram" => Some(execute(NGram::new(cfg), cfg, name))
        _ => None
    }
}

fn main() {
    let args = env::args()
    let path = args.first().unwrap_or("../run.js")
    let filter = args.get(1).unwrap_or("").to_lowercase()

    println("start: {}", time::now_ms())
    let cfg = match Config::load(path) {
        Ok(cfg) => cfg
        Err(e) => {
            eprintln("failed to load config {}: {}", path, e)
            process::exit(1)
        }
    }

    let mut total = 0.0
    let mut ok = 0
    let mut fails = 0

    for name in cfg.order() {
        if filter != "" && !name.to_lowercase().contains(filter) { continue }
        match dispatch(cfg, name) {
            Some((elapsed, passed)) => {
                total += elapsed
                if passed { ok += 1 } else { fails += 1 }
            }
            None => println("Warning: Benchmark '{}' defined in config but not found in code", name)
        }
    }

    println("Summary: {:.4}s, {}, {}, {}", total, ok + fails, ok, fails)

    let _ = fs::write("/tmp/recompile_marker", "RECOMPILE_MARKER_0".as_bytes())

    if fails > 0 { process::exit(1) }
}
