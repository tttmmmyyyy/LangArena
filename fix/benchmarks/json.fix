// Writes a document of coordinates as JSON, and reads the coordinates back out of it.
module LangArena.Benchmarks.Json;

import Json::{read, Json, Json::{as_array, as_number, as_object, string}, Object::find};
import LangArena.Bench::{make, Bench, MakeBench};
import LangArena.Benchmarks.JsonDecode::read_points;
import LangArena.Helper::{checksum_float, config_i64, next_float, next_int, Rng};
import Math::round;
import Std.Experimental::{Format, F64::with_precision, Format::{write_text, TextOut}, String::format};
import Std::{
    Array, Bool, F64, I64, String, U32, U8, Array::{@, @size, empty, push_back}, Functor::map, 
    Iterator::{fold, map, range, sum}, Option::{as_some, some}, Result::as_ok, String::find, 
    ToF64::f64, Tuple3::{@0, @1, @2}
};

_generate_name : String = "Json::Generate";
_parse_dom_name : String = "Json::ParseDom";
_parse_mapping_name : String = "Json::ParseMapping";

// The document opens with the array of coordinates, which is what the writing benchmark counts.
_opening : String = "{\"coordinates\":";

// A number rounded to eight decimal places.
//
// # Parameters
// * `value` - The number to round.
_rounded : F64 -> F64;
_rounded = |value| (value * 100000000.0).round / 100000000.0;

// One entry of the document: a coordinate's three numbers, its name, and a table of options.
type Coordinate = unbox struct {
    x : F64, y : F64, z : F64, name : String, opts : Array (String, (I64, Bool))
};

// The document the benchmarks work over: the coordinates, and a line of information.
type Document = unbox struct { coordinates : Array Coordinate, info : String };

// Writes an entry as a JSON object. The names of its members are written as they stand, the way a
// serializer derived from the struct writes them.
impl Coordinate : Format {
    write_text = |c, out| (
        out.write_text("{\"x\":").write_text(c.@x)
            .write_text(",\"y\":").write_text(c.@y)
            .write_text(",\"z\":").write_text(c.@z)
            .write_text(",\"name\":").write_text(Json::string(c.@name))
            .write_text(",\"opts\":")._write_options(c.@opts)
            .write_text("}")
    );
}

// Writes a table of options as a JSON object, each value as an array of its two parts.
//
// # Parameters
// * `options` - The table to write.
// * `out` - The text written so far.
_write_options : Array (String, (I64, Bool)) -> TextOut -> TextOut;
_write_options = |options, out| (
    let out = range(0, options.@size).fold(out.write_text("{"), |i, out|
        let (name, (number, flag)) = options.@(i);
        let out = if i == 0 { out } else { out.write_text(",") };
        out.write_text(Json::string(name)).write_text(":[").write_text(number).write_text(",")
            .write_text(flag).write_text("]")
    );
    out.write_text("}")
);

// Writes the document as a JSON object.
impl Document : Format {
    write_text = |d, out| (
        let coordinates = d.@coordinates;
        let out = range(0, coordinates.@size).fold(out.write_text(_opening).write_text("["), |i, out|
            let out = if i == 0 { out } else { out.write_text(",") };
            out.write_text(coordinates.@(i))
        );
        out.write_text("],\"info\":").write_text(Json::string(d.@info)).write_text("}")
    );
}

// Builds the document the benchmarks work over: one entry per coordinate.
//
// # Parameters
// * `coords` - How many coordinates the document holds.
// * `rng` - The generator the numbers come from.
_build : I64 -> Rng -> Document;
_build = |coords, rng| (
    let (coordinates, _) = range(0, coords).fold((Array::empty(coords), rng), |_, (coordinates, rng)|
        let (x, rng) = rng.next_float(1.0);
        let (y, rng) = rng.next_float(1.0);
        let (z, rng) = rng.next_float(1.0);
        let (marker, rng) = rng.next_float(1.0);
        let (tag, rng) = rng.next_int(10000);
        let coordinate = Coordinate {
            x : _rounded(x),
            y : _rounded(y),
            z : _rounded(z),
            name : "{} {}".format((marker.with_precision(7_U8), tag)),
            opts : [("1", (1, true))]
        };
        (coordinates.push_back(coordinate), rng)
    );
    Document { coordinates : coordinates, info : "some info" }
);

// The document written as JSON.
//
// # Parameters
// * `document` - The document to write.
_write : Document -> String;
_write = |document| "{}".format((document,));

// The entries of a document, as the three numbers each of them holds.
//
// # Parameters
// * `document` - The document to read.
_points : Json -> Array (F64, F64, F64);
_points = |document| (
    document.as_object.find("coordinates").as_some.as_array.map(|entry|
        let entry = entry.as_object;
        (
            entry.find("x").as_some.as_number,
            entry.find("y").as_some.as_number,
            entry.find("z").as_some.as_number
        )
    )
);

// The checksum of the three averages of a list of points, which is what the reading benchmarks
// report.
//
// # Parameters
// * `points` - The points to average.
_average_checksum : Array (F64, F64, F64) -> U32;
_average_checksum = |points| (
    let count = points.@size.f64;
    let (x, y, z) = range(0, points.@size).fold((0.0, 0.0, 0.0), |i, (x, y, z)|
        let point = points.@(i);
        (x + point.@0, y + point.@1, z + point.@2)
    );
    checksum_float(x / count) + checksum_float(y / count) + checksum_float(z / count)
);

// The writing benchmark, which counts the writings that opened with the array of coordinates.
//
// # Parameters
// * `document` - The document to write.
// * `total` - The count of the writings so far.
_make_generate_bench : Document -> U32 -> Bench;
_make_generate_bench = |document, total| Bench::make(
    |iterations| (
        let total = total + range(0, iterations).map(|_|
            let text = _write(document);
            if text.find(_opening, 0) == some(0) { 1_U32 } else { 0_U32 }
        ).sum;
        _make_generate_bench(document, total)
    ),
    |_| total
);

// The reading benchmarks, which read the document back and report the checksums of the averages of
// the coordinates it held.
//
// # Parameters
// * `read` - The way the coordinates are taken out of the text.
// * `text` - The text to read.
// * `total` - The sum of the checksums so far.
_make_parse_bench : (String -> Array (F64, F64, F64)) -> String -> U32 -> Bench;
_make_parse_bench = |read, text, total| Bench::make(
    |iterations| (
        let total = total + range(0, iterations).map(|_| _average_checksum(read(text))).sum;
        _make_parse_bench(read, text, total)
    ),
    |_| total
);

// Reads a document into a tree and takes the coordinates out of it.
//
// # Parameters
// * `text` - The text to read.
_read : String -> Array (F64, F64, F64);
_read = |text| _points(Json::read(text).as_ok);

// Reads the coordinates out of a document without building a tree for it.
//
// # Parameters
// * `text` - The text to read.
_read_points : String -> Array (F64, F64, F64);
_read_points = |text| JsonDecode::read_points(text).as_ok;

// The benchmarks, as the runner's registry holds them. The reading benchmarks read the text the
// writing benchmark writes.
generate_entry : (String, MakeBench);
generate_entry = (_generate_name, |config, rng|
    _make_generate_bench(_build(config.config_i64(_generate_name, "coords"), rng), 0_U32)
);

parse_dom_entry : (String, MakeBench);
parse_dom_entry = (_parse_dom_name, |config, rng| _make_parse_bench(
    _read,
    _write(_build(config.config_i64(_parse_dom_name, "coords"), rng)),
    0_U32
));

parse_mapping_entry : (String, MakeBench);
parse_mapping_entry = (_parse_mapping_name, |config, rng| _make_parse_bench(
    _read_points,
    _write(_build(config.config_i64(_parse_mapping_name, "coords"), rng)),
    0_U32
));
