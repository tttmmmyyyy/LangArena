// Reads the coordinates out of a JSON document the way `LangArena.Benchmarks.JsonPoints` reads
// them, with the position carried by a monad instead of by hand.
//
// The grammar and the order of the reads are the same as that module's, so what separates the two
// is the plumbing alone: there, every step takes the bytes and a position and answers with the
// position after it; here, every step is a `Decoder` and the positions are threaded by `bind`.
module LangArena.Benchmarks.JsonDecode;

import Json.Number::parse;
import Std::{
    Array, Bool, ErrMsg, F64, Functor, I64, Monad, Result, String, U8,
    Array::{empty, get_sub, push_back, @, @size},
    LoopState::{break, break_m, continue, continue_m}, Monad::pure,
    Result::{as_err, as_ok, err, is_err, ok}, String::get_bytes, ToString::to_string,
    loop, loop_m
};

// A document and how far into it a reading has come.
type Cursor = unbox struct { bytes : Array U8, size : I64, at : I64 };

// A reading that takes a value out of a document and leaves the position after it.
type Decoder a = unbox struct { _run : Cursor -> Result ErrMsg (a, Cursor) };

namespace Decoder {
    // Runs a reading over a cursor.
    //
    // # Parameters
    // * `cursor` - Where the reading begins.
    // * `decoder` - The reading to run.
    run : Cursor -> Decoder a -> Result ErrMsg (a, Cursor);
    run = |cursor, decoder| (decoder.@_run)(cursor);

    // A reading that fails, saying what the grammar expected and where.
    //
    // # Parameters
    // * `what` - What the grammar expected there.
    expected : String -> Decoder a;
    expected = |what| Decoder { _run : |c| err $ "expected " + what + " at " + c.@at.to_string };
}

impl Decoder : Functor {
    map = |f, decoder| Decoder { _run : |c| (
        let (value, c) = *decoder.run(c);
        ok $ (f(value), c)
    ) };
}

impl Decoder : Monad {
    pure = |value| Decoder { _run : |c| ok $ (value, c) };
    bind = |f, decoder| Decoder { _run : |c| (
        let (value, c) = *decoder.run(c);
        f(value).run(c)
    ) };
}

// Reads a document and answers with the three numbers of each of its coordinates.
//
// # Parameters
// * `text` - The document to read.
read_points : String -> Result ErrMsg (Array (F64, F64, F64));
read_points = |text| (
    // `get_bytes` answers with the string's own array, which the string keeps holding, so
    // dropping its null terminator would copy the whole of it. The terminator is left in place
    // and the length stops one short of it.
    let bytes = text.get_bytes;
    let cursor = Cursor { bytes : bytes, size : bytes.@size - 1, at : 0 };
    let (points, _) = *_document.run(cursor);
    ok $ points
);

// The name of the member holding the coordinates.
_coordinates : Array U8 = "coordinates".get_bytes.get_sub(0, 11);

// The names of the three numbers a coordinate holds, in the order this reading keeps them.
_x : Array U8 = "x".get_bytes.get_sub(0, 1);
_y : Array U8 = "y".get_bytes.get_sub(0, 1);
_z : Array U8 = "z".get_bytes.get_sub(0, 1);

// Reads the outermost object and answers with the coordinates its `coordinates` member holds.
_document : Decoder (Array (F64, F64, F64));
_document = (
    _skip_space;;
    _expect('{', "an object");;
    loop_m(Array::empty(0), |points|
        _skip_space;;
        let closed = *_at('}');
        if closed { _step;; break_m $ points };
        let (from, to) = *_member;
        if *_named(from, to, _coordinates) {
            let points = *_points;
            let more = *_separated('}');
            if more { continue_m $ points } else { break_m $ points }
        };
        _skip_value;;
        let more = *_separated('}');
        if more { continue_m $ points } else { break_m $ points }
    )
);

// Reads the array of coordinates.
_points : Decoder (Array (F64, F64, F64));
_points = (
    _expect('[', "an array of coordinates");;
    _skip_space;;
    let closed = *_at(']');
    if closed { _step;; pure $ Array::empty(0) };
    loop_m(Array::empty(1024), |points|
        let point = *_point;
        let points = points.push_back(point);
        let more = *_separated(']');
        if more { continue_m $ points } else { break_m $ points }
    )
);

// Reads one coordinate.
_point : Decoder (F64, F64, F64);
_point = (
    _skip_space;;
    _expect('{', "a coordinate");;
    loop_m((0.0, 0.0, 0.0), |(x, y, z)|
        _skip_space;;
        let closed = *_at('}');
        if closed { _step;; break_m $ (x, y, z) };
        let (from, to) = *_member;
        let is_x = *_named(from, to, _x);
        let is_y = *_named(from, to, _y);
        let is_z = *_named(from, to, _z);
        if is_x || is_y || is_z {
            let value = *_number;
            let point = if is_x { (value, y, z) } else if is_y { (x, value, z) } else {
                (x, y, value)
            };
            let more = *_separated('}');
            if more { continue_m $ point } else { break_m $ point }
        };
        _skip_value;;
        let more = *_separated('}');
        if more { continue_m $ (x, y, z) } else { break_m $ (x, y, z) }
    )
);

// Reads a member's name and the colon behind it, and answers with where the name's bytes begin
// and where they end.
_member : Decoder (I64, I64);
_member = (
    let quoted = *_at('"');
    if !quoted { Decoder::expected("a member name") };
    _step;;
    let (from, to) = *_name;
    _skip_space;;
    _expect(':', "`:`");;
    _skip_space;;
    pure $ (from, to)
);

// Reads the byte that closes a member list or separates it from the next member, and answers
// with whether another member follows.
//
// # Parameters
// * `closing` - The byte that closes this list.
_separated : U8 -> Decoder Bool;
_separated = |closing| (
    _skip_space;;
    let separated = *_at(',');
    if separated { _step;; pure $ true };
    let closed = *_at(closing);
    if closed { _step;; pure $ false };
    Decoder::expected("`,` or a closing byte")
);

// Whether the byte at the cursor is `byte`, which is false where the document has ended.
//
// # Parameters
// * `byte` - The byte to look for.
_at : U8 -> Decoder Bool;
_at = |byte| Decoder { _run : |c|
    ok $ (c.@at < c.@size && c.@bytes.@(c.@at) == byte, c)
};

// Moves the cursor one byte on.
_step : Decoder ();
_step = Decoder { _run : |c| ok $ ((), c.set_at(c.@at + 1)) };

// Reads the byte `byte`, failing where the document holds something else.
//
// # Parameters
// * `byte` - The byte the grammar expects there.
// * `what` - What to call it in the report.
_expect : U8 -> String -> Decoder ();
_expect = |byte, what| (
    let there = *_at(byte);
    if !there { Decoder::expected(what) };
    _step
);

// Moves the cursor past the white space it stands on.
_skip_space : Decoder ();
_skip_space = Decoder { _run : |c|
    let size = c.@size;
    let bytes = c.@bytes;
    let at = loop((c.@at), |at|
        if at >= size { break $ at };
        let byte = bytes.@(at);
        if byte == ' ' || byte == '\t' || byte == '\n' || byte == '\r' { continue $ at + 1 };
        break $ at
    );
    ok $ ((), c.set_at(at))
};

// Reads the rest of a string whose opening quote the cursor has passed, and answers with where
// its bytes begin and where they end.
_name : Decoder (I64, I64);
_name = Decoder { _run : |c|
    let size = c.@size;
    let bytes = c.@bytes;
    let from = c.@at;
    loop((from), |i|
        if i >= size { break $ err $ "expected a closing quote at " + i.to_string };
        let byte = bytes.@(i);
        if byte == '"' { break $ ok $ ((from, i), c.set_at(i + 1)) };
        if byte == '\\' { continue $ i + 2 };
        continue $ i + 1
    )
};

// Whether the bytes from `from` to `to` are the bytes of `name`.
//
// # Parameters
// * `from` - The position of the first byte of the name read from the document.
// * `to` - The position after its last byte.
// * `name` - The name to compare it against.
_named : I64 -> I64 -> Array U8 -> Decoder Bool;
_named = |from, to, name| Decoder { _run : |c|
    if to - from != name.@size { ok $ (false, c) };
    let bytes = c.@bytes;
    let same = loop((0), |i|
        if i == name.@size { break $ true };
        if bytes.@(from + i) != name.@(i) { break $ false };
        continue $ i + 1
    );
    ok $ (same, c)
};

// Reads a number, which runs to the first byte that no number can carry.
_number : Decoder F64;
_number = Decoder { _run : |c|
    let size = c.@size;
    let bytes = c.@bytes;
    let at = c.@at;
    let end = loop((at), |i|
        if i >= size { break $ i };
        let byte = bytes.@(i);
        let carries = ('0' <= byte && byte <= '9') || byte == '-' || byte == '+' || byte == '.'
            || byte == 'e' || byte == 'E';
        if carries { continue $ i + 1 };
        break $ i
    );
    if end == at { err $ "expected a number at " + at.to_string };
    let value = *Json.Number::parse(bytes, at, end);
    ok $ (value, c.set_at(end))
};

// Moves the cursor past the value it stands on, building nothing for it.
_skip_value : Decoder ();
_skip_value = (
    let quoted = *_at('"');
    if quoted { _step;; _name;; pure() };
    let object = *_at('{');
    let array = *_at('[');
    if object || array { _skip_nested };
    _skip_plain
);

// Moves the cursor past a number, `true`, `false` or `null`.
_skip_plain : Decoder ();
_skip_plain = Decoder { _run : |c|
    let size = c.@size;
    let bytes = c.@bytes;
    let at = c.@at;
    let end = loop((at), |i|
        if i >= size { break $ i };
        let byte = bytes.@(i);
        if byte == ',' || byte == '}' || byte == ']' || byte == ' ' || byte == '\t'
            || byte == '\n' || byte == '\r' { break $ i };
        continue $ i + 1
    );
    if end == at { err $ "expected a value at " + at.to_string };
    ok $ ((), c.set_at(end))
};

// Moves the cursor past the object or array it stands on, counting the braces and brackets that
// open and close inside it.
_skip_nested : Decoder ();
_skip_nested = loop_m(0, |depth|
    let quoted = *_at('"');
    if quoted { _step;; _name;; continue_m $ depth };
    let object = *_at('{');
    let array = *_at('[');
    if object || array { _step;; continue_m $ depth + 1 };
    let closed_object = *_at('}');
    let closed_array = *_at(']');
    if closed_object || closed_array {
        _step;;
        if depth == 1 { break_m $ () } else { continue_m $ depth - 1 }
    };
    let ended = *_ended;
    if ended { Decoder::expected("a closing brace or bracket") };
    _step;;
    continue_m $ depth
);

// Whether the cursor has reached the end of the document.
_ended : Decoder Bool;
_ended = Decoder { _run : |c| ok $ (c.@at >= c.@size, c) };
