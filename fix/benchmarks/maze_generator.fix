// Digs a maze out of a grid of walls, from the start corner and again from the finish corner.
module LangArena.Benchmarks.MazeGenerator;

import Std;
import LangArena.Bench;
import LangArena.Helper;

_name : String = "Maze::Generator";

// What a cell holds. The numbers are the ones the checksum of the middle cell reports.
_wall : U8 = 0_U8;
_space : U8 = 1_U8;
_start : U8 = 2_U8;
_finish : U8 = 3_U8;
_border : U8 = 4_U8;

// Whether a cell can be walked through.
//
// # Parameters
// * `kind` - What the cell holds.
_is_walkable : U8 -> Bool;
_is_walkable = |kind| kind == _space || kind == _start || kind == _finish;

// The grid: what each cell holds, and the four neighbours of each cell in the order they are to be
// visited, four entries per cell.
type Maze = struct { w : I64, h : I64, kinds : Array U8, neighbours : Array I64 };

// Marks the border, and gives every inner cell its four neighbours in an order the generator
// shuffles.
//
// # Parameters
// * `w` - Width of the grid in cells.
// * `h` - Height of the grid in cells.
// * `rng` - The generator the shuffles are drawn from.
_build : I64 -> I64 -> Rng -> Maze;
_build = |w, h, rng| (
    let kinds = from_map(w * h, |i|
        let (y, x) = (i / w, i % w);
        if x == 0 || y == 0 || x == w - 1 || y == h - 1 { _border } else { _wall }
    );
    let (neighbours, _) = range(1, h - 1).fold((fill(w * h * 4, 0), rng), |y, (neighbours, rng)|
        range(1, w - 1).fold((neighbours, rng), |x, (neighbours, rng)|
            let base = (y * w + x) * 4;
            let neighbours = neighbours
                .set(base, (y - 1) * w + x)
                .set(base + 1, (y + 1) * w + x)
                .set(base + 2, y * w + x + 1)
                .set(base + 3, y * w + x - 1);
            range(0, 4).fold((neighbours, rng), |_, (neighbours, rng)|
                let (i, rng) = rng.next_int(4);
                let (j, rng) = rng.next_int(4);
                if i == j { (neighbours, rng) };
                let (a, b) = (neighbours.@(base + i), neighbours.@(base + j));
                (neighbours.set(base + i, b).set(base + j, a), rng)
            )
        )
    );
    let kinds = kinds.set(w + 1, _start).set((h - 2) * w + w - 2, _finish);
    Maze { w : w, h : h, kinds : kinds, neighbours : neighbours }
);

// Turns every dug cell back into a wall, leaving the start and the finish where they are.
//
// # Parameters
// * `maze` - The grid to clear.
_reset : Maze -> Maze;
_reset = |maze| (
    let (w, h) = (maze.@w, maze.@h);
    let maze = maze.mod_kinds(|kinds|
        range(0, kinds.@size).fold(kinds, |i, kinds|
            if kinds.@(i) != _space { kinds } else { kinds.set(i, _wall) }
        )
    );
    maze.mod_kinds(|kinds| kinds.set(w + 1, _start).set((h - 2) * w + w - 2, _finish))
);

// How many of a cell's neighbours can be walked through.
//
// # Parameters
// * `cell` - The cell to look around.
// * `maze` - The grid to look in.
_walkable_neighbours : I64 -> Maze -> I64;
_walkable_neighbours = |cell, maze| (
    range(0, 4).fold(0, |k, count|
        count + if _is_walkable(maze.@kinds.@(maze.@neighbours.@(cell * 4 + k))) { 1 } else { 0 }
    )
);

// Digs a corridor from a cell, opening every wall that has exactly one way out and following the
// walls around it.
//
// # Parameters
// * `from` - The cell to dig from.
// * `maze` - The grid to dig in.
_dig : I64 -> Maze -> Maze;
_dig = |from, maze| (
    let (maze, _) = loop((maze, [from]), |(maze, stack)|
        if stack.@size == 0 { break $ (maze, stack) };
        let cell = stack.@(stack.@size - 1);
        let stack = stack.pop_back;
        if _walkable_neighbours(cell, maze) != 1 { continue $ (maze, stack) };
        let maze = maze.mod_kinds(set(cell, _space));
        let stack = range(0, 4).fold(stack, |k, stack|
            let neighbour = maze.@neighbours.@(cell * 4 + k);
            if maze.@kinds.@(neighbour) != _wall { stack } else { stack.push_back(neighbour) }
        );
        continue $ (maze, stack)
    );
    maze
);

// Opens a wall next to the finish, and follows the walls around it until the finish has more than
// one way out.
//
// # Parameters
// * `cell` - The cell to open.
// * `maze` - The grid to open it in.
_open_towards_finish : I64 -> Maze -> Maze;
_open_towards_finish = |cell, maze| (
    let maze = maze.mod_kinds(set(cell, _space));
    let walls = range(0, 4).fold(Array::empty(4), |k, walls|
        let neighbour = maze.@neighbours.@(cell * 4 + k);
        if maze.@kinds.@(neighbour) != _wall { walls } else { walls.push_back(neighbour) }
    );
    if _walkable_neighbours(cell, maze) > 1 { maze };
    range(0, walls.@size).fold(maze, |i, maze| _open_towards_finish(walls.@(i), maze))
);

// Digs the maze: corridors from the start corner, then a way out of the finish corner.
//
// # Parameters
// * `maze` - The grid to dig.
_generate : Maze -> Maze;
_generate = |maze| (
    let (w, h) = (maze.@w, maze.@h);
    let start = w + 1;
    let maze = range(0, 4).fold(maze, |k, maze|
        let neighbour = maze.@neighbours.@(start * 4 + k);
        if maze.@kinds.@(neighbour) != _wall { maze } else { _dig(neighbour, maze) }
    );
    let finish = (h - 2) * w + w - 2;
    range(0, 4).fold(maze, |k, maze|
        let neighbour = maze.@neighbours.@(finish * 4 + k);
        if maze.@kinds.@(neighbour) != _wall { maze } else { _open_towards_finish(neighbour, maze) }
    )
);

// The FNV hash of the dug cells, each taken as the product of its coordinates.
//
// # Parameters
// * `maze` - The grid to take the checksum of.
_maze_checksum : Maze -> U32;
_maze_checksum = |maze| (
    let w = maze.@w;
    range(0, maze.@kinds.@size).fold(2166136261_U32, |i, hash|
        if maze.@kinds.@(i) != _space { hash };
        (hash.bit_xor(((i / w) * (i % w)).u32)) * 16777619_U32
    )
);

// The benchmark holding the grid and the sum of the middle cells so far.
//
// # Parameters
// * `maze` - The grid to dig.
// * `total` - The sum of the middle cells so far.
_make_bench : Maze -> U32 -> Bench;
_make_bench = |maze, total| Bench::make(
    |iterations| (
        let (maze, total) = range(0, iterations).fold((maze, total), |_, (maze, total)|
            let maze = maze._reset._generate;
            let middle = (maze.@h / 2) * maze.@w + maze.@w / 2;
            (maze, total + maze.@kinds.@(middle).u32)
        );
        _make_bench(maze, total)
    ),
    |_| total + _maze_checksum(maze)
);

// The benchmark, as the runner's registry holds it.
entry : (String, MakeBench);
entry = (_name, |config, rng|
    let w = max(5, config.config_i64(_name, "w"));
    let h = max(5, config.config_i64(_name, "h"));
    _make_bench(_build(w, h, rng), 0_U32)
);
