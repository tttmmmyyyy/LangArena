// Writes a long run of one letter in base 64, and reads it back.
module LangArena.Benchmarks.Base64;

import LangArena.Bench::{make, Bench, MakeBench};
import LangArena.Helper::{checksum_str, config_i64, string_of};
import Minilib.Encoding.Base64::{base64_decode, base64_encode};
import Std::{
    Array, I64, String, U32, U8, Array::{fill, get_sub, @size}, Iterator::{fold, range},
    String::{get_sub, @size}, ToString::to_string, ToU32::u32, ToU8::u8
};

_encode_name : String = "Base64::Encode";
_decode_name : String = "Base64::Decode";

// The first four characters of a text with an ellipsis behind them, or the whole text when it is
// no longer than four.
//
// # Parameters
// * `text` - The text to shorten.
_shortened : String -> String;
_shortened = |text| (
    if text.String::@size <= 4 { text };
    text.String::get_sub(0, 4) + "..."
);

// The writing benchmark, which counts the characters each writing produces and reports a line
// naming what it wrote and what it wrote it as.
//
// # Parameters
// * `text` - The bytes to write.
// * `coded` - What the last writing produced.
// * `total` - The count of the writings so far.
_make_encode_bench : Array U8 -> String -> U32 -> Bench;
_make_encode_bench = |text, coded, total| Bench::make(
    |iterations| (
        let (coded, total) = range(0, iterations).fold((coded, total), |_, (_, total)|
            let coded = base64_encode(text);
            (coded, total + coded.String::@size.u32)
        );
        _make_encode_bench(text, coded, total)
    ),
    |_| checksum_str(
        "encode " + text.string_of._shortened + " to " + coded._shortened + ": " + total.to_string
    )
);

// The reading benchmark, which counts the bytes each reading produces and reports a line naming
// what it read and what it read it as.
//
// # Parameters
// * `coded` - The characters to read.
// * `text` - What the last reading produced.
// * `total` - The count of the readings so far.
_make_decode_bench : String -> Array U8 -> U32 -> Bench;
_make_decode_bench = |coded, text, total| Bench::make(
    |iterations| (
        let (text, total) = range(0, iterations).fold((text, total), |_, (_, total)|
            let text = base64_decode(coded);
            (text, total + text.Array::@size.u32)
        );
        _make_decode_bench(coded, text, total)
    ),
    |_| checksum_str(
        "decode " + coded._shortened + " to " + text.Array::get_sub(0, 4).string_of + "...: "
            + total.to_string
    )
);

// The benchmarks, as the runner's registry holds them.
encode_entry : (String, MakeBench);
encode_entry = (_encode_name, |config, _|
    let text = fill(config.config_i64(_encode_name, "size"), 'a');
    _make_encode_bench(text, base64_encode(text), 0_U32)
);

decode_entry : (String, MakeBench);
decode_entry = (_decode_name, |config, _|
    let coded = base64_encode(fill(config.config_i64(_decode_name, "size"), 'a'));
    _make_decode_bench(coded, base64_decode(coded), 0_U32)
);
