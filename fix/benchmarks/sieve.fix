// Counts the primes up to a limit with the sieve of Eratosthenes, rebuilding the sieve on every
// iteration so that the allocation is part of the work.
module LangArena.Benchmarks.Sieve;

import Std;
import LangArena.Bench;
import Math;
import LangArena.Helper;

_name : String = "Etc::Sieve";

// Sieves up to `limit` and returns the largest prime found plus the number of primes found.
//
// # Parameters
// * `limit` - The largest number considered.
_sieve : I64 -> I64;
_sieve = |limit| (
    let primes = Array::fill(limit + 1, 1_U8).set(0, 0_U8).set(1, 0_U8);
    let sqrt_limit = Math::sqrt(limit.f64).i64;
    let primes = Iterator::range(2, sqrt_limit + 1).fold(primes, |p, primes|
        if primes.@(p) != 1_U8 { primes };
        Iterator::range_step(p * p, limit + 1, p).fold(primes, |multiple, primes|
            primes.set(multiple, 0_U8)
        )
    );
    let (last_prime, count) = Iterator::range_step(3, limit + 1, 2).fold((2, 1), |n, (last_prime, count)|
        if primes.@(n) != 1_U8 { (last_prime, count) };
        (n, count + 1)
    );
    last_prime + count
);

_make_bench : I64 -> U32 -> Bench;
_make_bench = |limit, checksum| Bench {
    run_iters : |iterations| (
        let checksum = Iterator::range(0, iterations).fold(checksum, |_, checksum|
            checksum + _sieve(limit).u32
        );
        _make_bench(limit, checksum)
    ),
    checksum : |_| checksum
};

// The benchmark, as the runner's registry holds it.
entry : (String, MakeBench);
entry = (_name, |config, _| _make_bench(config.config_i64(_name, "limit"), 0_U32));
