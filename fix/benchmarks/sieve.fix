// Counts the primes up to a limit with the sieve of Eratosthenes, rebuilding the sieve on every
// iteration so that the allocation is part of the work.
module LangArena.Benchmarks.Sieve;

import LangArena.Bench::{make, Bench, MakeBench};
import LangArena.Helper::config_i64;
import Math::sqrt;
import Std::{
    I64, String, U32, Array::{fill, set, @}, Iterator::{fold, map, range, range_step, sum}, ToF64::f64, 
    ToI64::i64, ToU32::u32
};

_name : String = "Etc::Sieve";

// Sieves up to `limit` and returns the largest prime found plus the number of primes found.
//
// # Parameters
// * `limit` - The largest number considered.
_sieve : I64 -> I64;
_sieve = |limit| (
    let primes = fill(limit + 1, 1_U8).set(0, 0_U8).set(1, 0_U8);
    let sqrt_limit = limit.f64.sqrt.i64;
    let primes = range(2, sqrt_limit + 1).fold(primes, |p, primes|
        if primes.@(p) != 1_U8 { primes };
        range_step(p * p, limit + 1, p).fold(primes, |multiple, primes|
            primes.set(multiple, 0_U8)
        )
    );
    let (last_prime, count) = range_step(3, limit + 1, 2).fold((2, 1), |n, (last_prime, count)|
        if primes.@(n) != 1_U8 { (last_prime, count) };
        (n, count + 1)
    );
    last_prime + count
);

// The benchmark holding the sieve's limit and the checksum accumulated so far.
//
// # Parameters
// * `limit` - The largest number the sieve considers.
// * `checksum` - The checksum of the iterations run so far.
_make_bench : I64 -> U32 -> Bench;
_make_bench = |limit, checksum| Bench::make(
    |iterations| (
        let checksum = checksum + range(0, iterations).map(|_| _sieve(limit).u32).sum;
        _make_bench(limit, checksum)
    ),
    |_| checksum
);

// The benchmark, as the runner's registry holds it.
entry : (String, MakeBench);
entry = (_name, |config, _| _make_bench(config.config_i64(_name, "limit"), 0_U32));
