module Main;

import LangArena.Bench::{run_all, unix_millis, MakeBench};
import LangArena.Benchmarks.Base64::{decode_entry, encode_entry};
import LangArena.Benchmarks.Binarytrees::{arena_entry, obj_entry};
import LangArena.Benchmarks.Brainfuck::{array_entry, recursion_entry};
import LangArena.Benchmarks.BufferHash::{crc32_entry, sha256_entry};
import LangArena.Benchmarks.CacheSimulation::entry;
import LangArena.Benchmarks.Calculator::{ast_entry, interpreter_entry};
import LangArena.Benchmarks.CompressArith::{decode_entry, encode_entry};
import LangArena.Benchmarks.CompressBwt::{decode_entry, encode_entry};
import LangArena.Benchmarks.CompressHuffman::{decode_entry, encode_entry};
import LangArena.Benchmarks.CompressLzw::{decode_entry, encode_entry};
import LangArena.Benchmarks.CsvParse::entry;
import LangArena.Benchmarks.Distance::{jaro_entry, ngram_entry};
import LangArena.Benchmarks.Fannkuchredux::entry;
import LangArena.Benchmarks.GameOfLife::entry;
import LangArena.Benchmarks.GraphPath::{astar_entry, bfs_entry, dfs_entry};
import LangArena.Benchmarks.Json::{generate_entry, parse_dom_entry, parse_mapping_entry};
import LangArena.Benchmarks.LogParser::entry;
import LangArena.Benchmarks.Mandelbrot::entry;
import LangArena.Benchmarks.Matmul::{single_entry, t16_entry, t4_entry, t8_entry};
import LangArena.Benchmarks.Maze::{astar_entry, bfs_entry, generator_entry};
import LangArena.Benchmarks.Nbody::entry;
import LangArena.Benchmarks.NeuralNet::entry;
import LangArena.Benchmarks.Sieve::entry;
import LangArena.Benchmarks.Sort::{merge_entry, quick_entry, self_entry};
import LangArena.Benchmarks.Spectralnorm::entry;
import LangArena.Benchmarks.Template::{parse_entry, regexp_entry};
import LangArena.Benchmarks.TextRaytracer::entry;
import LangArena.Benchmarks.Words::entry;
import LangArena.Helper::read_config;
import Std::{
    Array, IO, Option, String, Array::{get_sub, to_iter, @, @size}, Functor::map, 
    IO::{exit, exit_with_msg, get_args, println, write_file_string, IOFail::try}, Iterator::check_any, 
    Monad::pure, Option::{is_some, none, some}, String::find, ToString::to_string
};

// Every benchmark this implementation provides. The runner looks names up here as it walks the
// configuration, so a name the configuration lists and this table lacks is reported and skipped.
_registry : Array (String, MakeBench);
_registry = [
    Base64::decode_entry,
    Base64::encode_entry,
    Binarytrees::arena_entry,
    Binarytrees::obj_entry,
    Brainfuck::array_entry,
    Brainfuck::recursion_entry,
    BufferHash::crc32_entry,
    BufferHash::sha256_entry,
    CacheSimulation::entry,
    Calculator::ast_entry,
    Calculator::interpreter_entry,
    CompressArith::decode_entry,
    CompressArith::encode_entry,
    CompressBwt::decode_entry,
    CompressBwt::encode_entry,
    CompressHuffman::decode_entry,
    CompressHuffman::encode_entry,
    CompressLzw::decode_entry,
    CompressLzw::encode_entry,
    CsvParse::entry,
    Distance::jaro_entry,
    Distance::ngram_entry,
    Fannkuchredux::entry,
    GameOfLife::entry,
    GraphPath::astar_entry,
    GraphPath::bfs_entry,
    GraphPath::dfs_entry,
    Json::generate_entry,
    Json::parse_dom_entry,
    Json::parse_mapping_entry,
    LogParser::entry,
    Mandelbrot::entry,
    Matmul::single_entry,
    Matmul::t16_entry,
    Matmul::t4_entry,
    Matmul::t8_entry,
    Maze::astar_entry,
    Maze::bfs_entry,
    Maze::generator_entry,
    Nbody::entry,
    NeuralNet::entry,
    Sieve::entry,
    Sort::merge_entry,
    Sort::quick_entry,
    Sort::self_entry,
    Spectralnorm::entry,
    Template::parse_entry,
    Template::regexp_entry,
    TextRaytracer::entry,
    Words::entry
];

_default_config_path : String = "../run.js";

// Splits the command line into the configuration path and the optional name filter. The path is
// recognised by its extension, matching how the other implementations read their arguments.
//
// # Parameters
// * `args` - The command line, without the program name.
_parse_args : Array String -> (String, Option String);
_parse_args = |args| (
    if args.@size == 0 { (_default_config_path, none()) };
    let head = args.@(0);
    let is_path = [".txt", ".json", ".js", ".config"].to_iter.check_any(|ext| head.find(ext, 0).is_some);
    if is_path {
        (head, if args.@size > 1 { some(args.@(1)) } else { none() })
    };
    (_default_config_path, some(head))
);

// The token the harness rewrites in this file to force a rebuild, so that it can measure how long
// an incremental compilation takes. Writing it out is what keeps it in the compiled program.
_touch_recompile_marker : IO ();
_touch_recompile_marker = (
    write_file_string("/tmp/recompile_marker", "RECOMPILE_MARKER_0").try(exit_with_msg(1))
);

main : IO ();
main = (
    let (path, filter) = *get_args.map(|args| _parse_args(args.get_sub(1, args.@size)));
    println("start: " + (*Bench::unix_millis).to_string);;
    let config = *Helper::read_config(path).try(exit_with_msg(1));
    let ok = *Bench::run_all(_registry, filter, config);
    _touch_recompile_marker;;
    if ok { pure() } else { exit(1) }
);
