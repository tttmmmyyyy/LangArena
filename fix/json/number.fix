// The decimal text a number is written in, read and written.
//
// Both ways stand on the one place where floating point is exact: a whole number below 2^53 and a
// power of ten below 10^23 are each held exactly, so scaling one by the other rounds once, and one
// rounding of the exact product is the nearest double to it. A number the digits cannot reach that
// way is read and written by the runtime's own conversion instead.
module Json.Number;

import Std::{
    Array, Bool, ErrMsg, F64, I64, Option, Result, String, U8,
    Array::{get_sub, push_back, @, @size}, F64::to_string_precision, FromBytes::from_bytes,
    FromString::from_string, LoopState::{break, continue}, Option::{as_some, is_some, none, some},
    Result::{as_ok, ok}, String::get_bytes, ToF64::f64, ToI64::i64, ToU8::u8, loop
};

// The number the bytes from `at` to `end` write.
//
// # Parameters
// * `bytes` - The bytes to read from.
// * `at` - The position of the number's first byte.
// * `end` - One past the position of its last byte.
parse : Array U8 -> I64 -> I64 -> Result ErrMsg F64;
parse = |bytes, at, end| (
    let exact = _exact(bytes, at, end);
    if exact.is_some { ok $ exact.as_some };
    from_string(bytes.get_sub(at, end)._string_of)
);

// Appends `value` to `buffer`, written to `precision` places after the point with the zeros that
// trail it dropped, and the point dropped with them where nothing is left behind it.
//
// # Parameters
// * `precision` - How many places the number is written to.
// * `buffer` - The buffer to append to.
// * `value` - The number to write.
append : U8 -> Array U8 -> F64 -> Array U8;
append = |precision, buffer, value| (
    let places = precision.i64;
    if places >= _powers_of_ten.@size { _append_by_runtime(precision, buffer, value) };
    let unit = _powers_of_ten.@(places);
    let scale = unit.f64;
    let scaled = value * scale;
    // A number that is not below the bound, and one that is not a number at all, fail this test.
    if !(scaled > -_whole_bound && scaled < _whole_bound) {
        _append_by_runtime(precision, buffer, value)
    };
    let whole = (if scaled < 0.0 { scaled - 0.5 } else { scaled + 0.5 }).i64;
    // The digits of the whole number are the number's own digits at this precision exactly when
    // scaling it back answers with the number itself.
    if whole.f64 / scale != value { _append_by_runtime(precision, buffer, value) };
    _append_digits(buffer, unit, value._is_negative, whole)
);

// A string made of the given bytes.
//
// # Parameters
// * `bytes` - The bytes of the string.
_string_of : Array U8 -> String;
_string_of = |bytes| bytes.push_back(0_U8).from_bytes.as_ok;

// The number the bytes from `at` to `end` write, when they write one whose nearest double is a
// whole number below `_mantissa_bound` scaled by a power of ten that a double holds exactly.
//
// # Parameters
// * `bytes` - The bytes to read from.
// * `at` - The position of the number's first byte.
// * `end` - One past the position of its last byte.
_exact : Array U8 -> I64 -> I64 -> Option F64;
_exact = |bytes, at, end| (
    let negative = bytes.@(at) == '-';
    let start = if negative { at + 1 } else { at };
    // Every digit joins one whole number, and every digit behind the point lowers by one the power
    // of ten that number is scaled by. The walk stops early on a digit that would carry the whole
    // number past what a double holds exactly, which the test below then reads off the number.
    let (mantissa, scale, _, at) = loop((0, 0, false, start), |(mantissa, scale, behind, i)|
        if i >= end { break $ (mantissa, scale, behind, i) };
        let c = bytes.@(i);
        if c == '.' { continue $ (mantissa, scale, true, i + 1) };
        if c < '0' || c > '9' { break $ (mantissa, scale, behind, i) };
        if mantissa >= _mantissa_bound { break $ (mantissa, scale, behind, i) };
        continue $ (
            mantissa * 10 + (c - '0').i64, if behind { scale - 1 } else { scale }, behind, i + 1
        )
    );
    if mantissa >= _mantissa_bound { none() };
    let (scale, at) = _exponent(bytes, at, end, scale);
    if at != end { none() };
    if scale <= -_exact_powers_of_ten.@size || scale >= _exact_powers_of_ten.@size { none() };
    let value = if scale >= 0 {
        mantissa.f64 * _exact_powers_of_ten.@(scale)
    } else {
        mantissa.f64 / _exact_powers_of_ten.@(-scale)
    };
    some $ if negative { -value } else { value }
);

// The power of ten the digits ask for once the exponent behind `e` is taken in, and where reading
// the exponent ends. Bytes that open with something else are left where they stand.
//
// # Parameters
// * `bytes` - The bytes to read from.
// * `at` - The position to read from.
// * `end` - One past the position of the number's last byte.
// * `scale` - The power of ten the digits ask for on their own.
_exponent : Array U8 -> I64 -> I64 -> I64 -> (I64, I64);
_exponent = |bytes, at, end, scale| (
    if at >= end { (scale, at) };
    let opener = bytes.@(at);
    if opener != 'e' && opener != 'E' { (scale, at) };
    let at = at + 1;
    if at >= end { (scale, at) };
    let sign = bytes.@(at);
    let negative = sign == '-';
    let at = if negative || sign == '+' { at + 1 } else { at };
    let (power, at) = loop((0, at), |(power, i)|
        if i >= end || power > _exact_powers_of_ten.@size { break $ (power, i) };
        let c = bytes.@(i);
        if c < '0' || c > '9' { break $ (power, i) };
        continue $ (power * 10 + (c - '0').i64, i + 1)
    );
    (if negative { scale - power } else { scale + power }, at)
);

// One past the largest whole number a double holds exactly.
_mantissa_bound : I64;
_mantissa_bound = 9007199254740992;

// The bound below which the neighbours of a number stand more than one apart, so that rounding it
// names one whole number and no other number rounds to the same one.
_whole_bound : F64;
_whole_bound = 4503599627370496.0;

// The powers of ten that fit in an `I64`.
_powers_of_ten : Array I64;
_powers_of_ten = [
    1, 10, 100, 1000, 10000, 100000, 1000000, 10000000, 100000000, 1000000000,
    10000000000, 100000000000, 1000000000000, 10000000000000, 100000000000000,
    1000000000000000, 10000000000000000, 100000000000000000, 1000000000000000000
];

// The powers of ten a double holds exactly.
_exact_powers_of_ten : Array F64;
_exact_powers_of_ten = [
    1.0, 10.0, 100.0, 1000.0, 10000.0, 100000.0, 1000000.0, 10000000.0, 100000000.0, 1000000000.0,
    10000000000.0, 100000000000.0, 1000000000000.0, 10000000000000.0, 100000000000000.0,
    1000000000000000.0, 10000000000000000.0, 100000000000000000.0, 1000000000000000000.0,
    10000000000000000000.0, 100000000000000000000.0, 1000000000000000000000.0,
    10000000000000000000000.0
];

// Whether a number is written behind a minus sign, which zero is when it is the negative zero.
//
// # Parameters
// * `value` - The number to test.
_is_negative : F64 -> Bool;
_is_negative = |value| value < 0.0 || (value == 0.0 && 1.0 / value < 0.0);

// Appends the digits of `scaled` to `buffer`, with the point placed so that the digits behind it
// stand for `1 / unit`, the zeros that trail it dropped, and the point dropped with them where
// nothing is left behind it.
//
// # Parameters
// * `buffer` - The buffer to append to.
// * `unit` - The power of ten the number was scaled by.
// * `negative` - Whether the number is written behind a minus sign.
// * `scaled` - The number to write times `unit`.
_append_digits : Array U8 -> I64 -> Bool -> I64 -> Array U8;
_append_digits = |buffer, unit, negative, scaled| (
    let buffer = if negative { buffer.push_back('-') } else { buffer };
    let scaled = if scaled < 0 { -scaled } else { scaled };
    let buffer = _append_whole(buffer, scaled / unit);
    let fraction = scaled % unit;
    if fraction == 0 { buffer };
    // Dividing the zeros that trail the fraction away shrinks the unit with them, and the unit that
    // is left says how many places the digits that remain fill.
    let (fraction, unit) = loop((fraction, unit), |(fraction, unit)|
        if fraction % 10 == 0 { continue $ (fraction / 10, unit / 10) };
        break $ (fraction, unit)
    );
    _append_places(buffer.push_back('.'), unit / 10, fraction)
);

// Appends `value` to `buffer` as its own digits, of which there is at least one.
//
// # Parameters
// * `buffer` - The buffer to append to.
// * `value` - The number to write, which is not negative.
_append_whole : Array U8 -> I64 -> Array U8;
_append_whole = |buffer, value| (
    let top = loop((1), |place|
        if value / place < 10 { break $ place };
        continue $ place * 10
    );
    _append_places(buffer, top, value)
);

// Appends `value` to `buffer` as the digits from the place `top` down to the ones, so that a value
// below `top` opens with as many zeros as it leaves places empty.
//
// # Parameters
// * `buffer` - The buffer to append to.
// * `top` - The place of the first digit, which is a power of ten.
// * `value` - The number to write, which is below ten times `top`.
_append_places : Array U8 -> I64 -> I64 -> Array U8;
_append_places = |buffer, top, value| (
    loop((buffer, top), |(buffer, place)|
        let buffer = buffer.push_back('0' + ((value / place) % 10).u8);
        if place == 1 { break $ buffer };
        continue $ (buffer, place / 10)
    )
);

// Appends a number to `buffer` as the runtime's formatter writes it, with the zeros that trail it
// dropped, and the point dropped with them where nothing is left behind it.
//
// # Parameters
// * `precision` - How many places the number is written to.
// * `buffer` - The buffer to append to.
// * `value` - The number to write.
_append_by_runtime : U8 -> Array U8 -> F64 -> Array U8;
_append_by_runtime = |precision, buffer, value| (
    let text = value.to_string_precision(precision);
    let bytes = text.get_bytes;
    let size = bytes.@size - 1;
    let point = loop((0), |i|
        if i == size { break $ -1 };
        if bytes.@(i) == '.' { break $ i };
        continue $ i + 1
    );
    let end = if point < 0 { size } else {
        loop((size - 1), |i|
            if i < 1 { break $ i + 1 };
            if bytes.@(i) == '0' { continue $ i - 1 };
            if bytes.@(i) == '.' { break $ i };
            break $ i + 1
        )
    };
    loop((buffer, 0), |(buffer, i)|
        if i == end { break $ buffer };
        continue $ (buffer.push_back(bytes.@(i)), i + 1)
    )
);
