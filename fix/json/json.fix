// A JSON document: the value it holds, the text it is written in, and the reading and writing that
// carry one into the other.
module Json;

import Std::{
    loop, Array, Bool, ErrMsg, F64, I64, Option, Result, String, U8, 
    Array::{@, @size, empty, get_sub, push_back}, F64::to_string_precision, FromBytes::from_bytes, 
    FromString::from_string, Iterator::{fold, range}, LoopState::{break, continue}, 
    Option::{as_some, is_some, none, some}, Result::{as_err, as_ok, err, is_err, ok}, String::get_bytes, 
    ToF64::f64, ToI64::i64, ToString::to_string, ToU8::u8, Tuple2::{@0, @1}
};

// A JSON value.
//
// The members of an object stand in the order the document gives them, and a member is found by
// scanning them, which beats a table for the few members an object carries.
type Json = union {
    null : (),
    bool : Bool,
    number : F64,
    string : String,
    object : Array (String, Json),
    array : Array Json
};

namespace Json {
    // The value the member named `name` holds, or `none` when the object carries no such member.
    //
    // # Parameters
    // * `name` - The name to look for.
    // * `members` - The members of an object.
    find : String -> Array (String, Json) -> Option Json;
    find = |name, members| (
        let size = members.@size;
        loop((0), |i|
            if i == size { break $ none() };
            let member = members.@(i);
            if member.@0 == name { break $ some(member.@1) };
            continue $ i + 1
        )
    );
}

// Reads a document. The text is read as the bytes it is written in.
//
// # Parameters
// * `text` - The document to read.
read : String -> Result ErrMsg Json;
read = |text| (
    // `get_bytes` answers with the string's own array, which the string keeps holding, so dropping
    // its null terminator would copy the whole of it. The terminator is left in place and the
    // length stops one short of it.
    let bytes = text.get_bytes.get_sub(0, text.get_bytes.@size - 1);
    let at = _skip_space(bytes, 0);
    let (value, at) = *Read::_value(bytes, at);
    let at = _skip_space(bytes, at);
    if at != bytes.@size { err $ "text left over at " + at.to_string };
    ok $ value
);

namespace Read {
    // The position of the first byte at or after `at` that is not white space.
    //
    // # Parameters
    // * `bytes` - The document's bytes.
    // * `at` - The position to start from.
    _skip_space : Array U8 -> I64 -> I64;
    _skip_space = |bytes, at| (
        let size = bytes.@size;
        loop((at), |at|
            if at >= size { break $ at };
            let c = bytes.@(at);
            if c == ' ' || c == '\t' || c == '\n' || c == '\r' {
                continue $ at + 1
            };
            break $ at
        )
    );

    // The error a document that ends, or holds something else, where a value was expected.
    //
    // # Parameters
    // * `what` - What the grammar expected there.
    // * `at` - Where it expected it.
    _expected : String -> I64 -> Result ErrMsg a;
    _expected = |what, at| err $ "expected " + what + " at " + at.to_string;

    // Reads the value beginning at `at`, and answers with it and the position after it.
    //
    // # Parameters
    // * `bytes` - The document's bytes.
    // * `at` - The position of the value's first byte.
    _value : Array U8 -> I64 -> Result ErrMsg (Json, I64);
    _value = |bytes, at| (
        if at >= bytes.@size { _expected("a value", at) };
        let c = bytes.@(at);
        if c == '{' { Read::_object(bytes, at + 1) };
        if c == '[' { Read::_array(bytes, at + 1) };
        if c == '"' {
            let (text, at) = *Read::_string(bytes, at + 1);
            ok $ (Json::string(text), at)
        };
        if c == 't' { _keyword(bytes, at, "true", Json::bool(true)) };
        if c == 'f' { _keyword(bytes, at, "false", Json::bool(false)) };
        if c == 'n' { _keyword(bytes, at, "null", Json::null()) };
        _number(bytes, at)
    );

    // Reads the literal `word` at `at` and answers with `value`.
    //
    // # Parameters
    // * `bytes` - The document's bytes.
    // * `at` - The position of the literal's first byte.
    // * `word` - The literal the grammar expects there.
    // * `value` - What that literal stands for.
    _keyword : Array U8 -> I64 -> String -> Json -> Result ErrMsg (Json, I64);
    _keyword = |bytes, at, word, value| (
        let letters = word.get_bytes;
        let size = letters.@size - 1;
        if at + size > bytes.@size { _expected(word, at) };
        let matches = range(0, size).fold(true, |i, matches|
            matches && bytes.@(at + i) == letters.@(i)
        );
        if !matches { _expected(word, at) };
        ok $ (value, at + size)
    );

    // Reads the members of an object, whose `{` sits before `at`, into the order they stand in.
    //
    // # Parameters
    // * `bytes` - The document's bytes.
    // * `at` - The position after the opening brace.
    _object : Array U8 -> I64 -> Result ErrMsg (Json, I64);
    _object = |bytes, at| (
        let at = _skip_space(bytes, at);
        if at < bytes.@size && bytes.@(at) == '}' {
            ok $ (Json::object(Array::empty(0)), at + 1)
        };
        let (members, at) = *loop(
            (Array::empty(8), at), |(members, at)|
            if at >= bytes.@size || bytes.@(at) != '"' {
                break $ _expected("a member name", at)
            };
            let name = Read::_string(bytes, at + 1);
            if name.is_err { break $ err $ name.as_err };
            let (name, at) = name.as_ok;
            let at = _skip_space(bytes, at);
            if at >= bytes.@size || bytes.@(at) != ':' { break $ _expected("`:`", at) };
            let at = _skip_space(bytes, at + 1);
            let value = Read::_value(bytes, at);
            if value.is_err { break $ err $ value.as_err };
            let (value, at) = value.as_ok;
            let members = members.push_back((name, value));
            let at = _skip_space(bytes, at);
            if at >= bytes.@size { break $ _expected("`,` or `}`", at) };
            let c = bytes.@(at);
            if c == ',' { continue $ (members, _skip_space(bytes, at + 1)) };
            if c == '}' { break $ ok $ (members, at + 1) };
            break $ _expected("`,` or `}`", at)
        );
        ok $ (Json::object(members), at)
    );

    // Reads the elements of an array, whose `[` sits before `at`.
    //
    // # Parameters
    // * `bytes` - The document's bytes.
    // * `at` - The position after the opening bracket.
    _array : Array U8 -> I64 -> Result ErrMsg (Json, I64);
    _array = |bytes, at| (
        let at = _skip_space(bytes, at);
        if at < bytes.@size && bytes.@(at) == ']' {
            ok $ (Json::array(Array::empty(0)), at + 1)
        };
        let (elements, at) = *loop(
            (Array::empty(8), at), |(elements, at)|
            let element = Read::_value(bytes, at);
            if element.is_err { break $ err $ element.as_err };
            let (element, at) = element.as_ok;
            let elements = elements.push_back(element);
            let at = _skip_space(bytes, at);
            if at >= bytes.@size { break $ _expected("`,` or `]`", at) };
            let c = bytes.@(at);
            if c == ',' { continue $ (elements, _skip_space(bytes, at + 1)) };
            if c == ']' { break $ ok $ (elements, at + 1) };
            break $ _expected("`,` or `]`", at)
        );
        ok $ (Json::array(elements), at)
    );

    // Reads the text of a string, whose opening quote sits before `at`.
    //
    // A string that carries no escape is the bytes between the quotes, which is the common case and is
    // taken whole. One that carries an escape is read byte by byte from the first escape onwards.
    //
    // # Parameters
    // * `bytes` - The document's bytes.
    // * `at` - The position after the opening quote.
    _string : Array U8 -> I64 -> Result ErrMsg (String, I64);
    _string = |bytes, at| (
        let size = bytes.@size;
        let plain_end = loop((at), |i|
            if i >= size { break $ i };
            let c = bytes.@(i);
            if c == '"' || c == '\\' { break $ i };
            continue $ i + 1
        );
        if plain_end >= size { _expected("a closing quote", plain_end) };
        if bytes.@(plain_end) == '"' {
            ok $ (bytes.get_sub(at, plain_end)._string_of, plain_end + 1)
        };
        _escaped_string(bytes, at, plain_end)
    );

    // Reads the text of a string that carries an escape, from the quote after `at` to its close.
    //
    // # Parameters
    // * `bytes` - The document's bytes.
    // * `at` - The position after the opening quote.
    // * `from` - The position of the first escape, whose bytes before it are taken as they stand.
    _escaped_string : Array U8 -> I64 -> I64 -> Result ErrMsg (String, I64);
    _escaped_string = |bytes, at, from| (
        let size = bytes.@size;
        let (text, at) = *loop(
            (bytes.get_sub(at, from), from), |(text, i)|
            if i >= size { break $ _expected("a closing quote", i) };
            let c = bytes.@(i);
            if c == '"' { break $ ok $ (text, i + 1) };
            if c != '\\' { continue $ (text.push_back(c), i + 1) };
            if i + 1 >= size { break $ _expected("an escape", i) };
            let e = bytes.@(i + 1);
            if e == 'u' {
                let code = _hex4(bytes, i + 2);
                if code.is_err { break $ err $ code.as_err };
                continue $ (_utf8(text, code.as_ok), i + 6)
            };
            let plain = _unescaped(e);
            if plain.is_err { break $ err $ plain.as_err };
            continue $ (text.push_back(plain.as_ok), i + 2)
        );
        ok $ (text._string_of, at)
    );

    // The byte an escape other than `\u` stands for.
    //
    // # Parameters
    // * `letter` - The letter behind the backslash.
    _unescaped : U8 -> Result ErrMsg U8;
    _unescaped = |letter| (
        if letter == '"' { ok $ '"' };
        if letter == '\\' { ok $ '\\' };
        if letter == '/' { ok $ '/' };
        if letter == 'b' { ok $ 8_U8 };
        if letter == 'f' { ok $ 12_U8 };
        if letter == 'n' { ok $ '\n' };
        if letter == 'r' { ok $ '\r' };
        if letter == 't' { ok $ '\t' };
        err $ "unknown escape"
    );

    // The number four hexadecimal digits at `at` write.
    //
    // # Parameters
    // * `bytes` - The document's bytes.
    // * `at` - The position of the first digit.
    _hex4 : Array U8 -> I64 -> Result ErrMsg I64;
    _hex4 = |bytes, at| (
        if at + 4 > bytes.@size { _expected("four hexadecimal digits", at) };
        range(0, 4).fold(ok $ 0, |i, code|
            if code.is_err { code };
            let c = bytes.@(at + i);
            let digit = if '0' <= c && c <= '9' { (c - '0').i64 }
                else if 'a' <= c && c <= 'f' { (c - 'a').i64 + 10 }
                else if 'A' <= c && c <= 'F' { (c - 'A').i64 + 10 }
                else { -1 };
            if digit < 0 { _expected("a hexadecimal digit", at + i) };
            ok $ code.as_ok * 16 + digit
        )
    );

    // The text with the code point `code` written into it as UTF-8.
    //
    // # Parameters
    // * `text` - The bytes written so far.
    // * `code` - The code point to write.
    _utf8 : Array U8 -> I64 -> Array U8;
    _utf8 = |text, code| (
        if code < 0x80 { text.push_back(code.u8) };
        if code < 0x800 {
            text.push_back((0xC0 + code / 64).u8).push_back((0x80 + code % 64).u8)
        };
        text.push_back((0xE0 + code / 4096).u8)
            .push_back((0x80 + code / 64 % 64).u8)
            .push_back((0x80 + code % 64).u8)
    );

    // Reads a number, which runs to the first byte that no number can carry.
    //
    // # Parameters
    // * `bytes` - The document's bytes.
    // * `at` - The position of the number's first byte.
    _number : Array U8 -> I64 -> Result ErrMsg (Json, I64);
    _number = |bytes, at| (
        let size = bytes.@size;
        let end = loop((at), |i|
            if i >= size { break $ i };
            let c = bytes.@(i);
            let carries = ('0' <= c && c <= '9') || c == '-' || c == '+' || c == '.'
                || c == 'e' || c == 'E';
            if carries { continue $ i + 1 };
            break $ i
        );
        if end == at { _expected("a number", at) };
        let value = *Number::parse(bytes, at, end);
        ok $ (Json::number(value), end)
    );
}

// Writes a document. Every number is written to `precision` places after the point, with the zeros
// that trail it dropped.
//
// # Parameters
// * `precision` - How many places a number is written to.
// * `document` - The tree to write.
write : U8 -> Json -> String;
write = |precision, document| (
    Write::_value(precision, Array::empty(1024), document)._string_of
);

namespace Write {
    // Appends the bytes of `text` to `buffer`.
    //
    // # Parameters
    // * `text` - The text to append.
    // * `buffer` - The buffer to append to.
    _append : String -> Array U8 -> Array U8;
    _append = |text, buffer| (
        // `get_bytes` answers with the string's own array, which the string keeps holding, so dropping
        // its null terminator would copy the whole of it. The terminator is left in place and the
        // length stops one short of it.
        let bytes = text.get_bytes;
        let size = bytes.@size - 1;
        range(0, size).fold(buffer, |i, buffer| buffer.push_back(bytes.@(i)))
    );

    // Appends the text of `value` to `buffer`.
    //
    // # Parameters
    // * `precision` - How many places a number is written to.
    // * `buffer` - The buffer to append to.
    // * `value` - The value to write.
    _value : U8 -> Array U8 -> Json -> Array U8;
    _value = |precision, buffer, value| (
        match value {
            null() => buffer._append("null"),
            bool(yes) => if yes { buffer._append("true") } else { buffer._append("false") },
            number(x) => Number::append(precision, buffer, x),
            string(text) => Write::_string(buffer, text),
            object(members) => Write::_object(precision, buffer, members),
            array(elements) => Write::_array(precision, buffer, elements)
        }
    );

    // Appends the members of an object to `buffer`, in the order they stand in.
    //
    // # Parameters
    // * `precision` - How many places a number is written to.
    // * `buffer` - The buffer to append to.
    // * `members` - The members to write.
    _object : U8 -> Array U8 -> Array (String, Json) -> Array U8;
    _object = |precision, buffer, members| (
        let size = members.@size;
        let buffer = buffer.push_back('{');
        let buffer = range(0, size).fold(buffer, |i, buffer|
            let member = members.@(i);
            let buffer = if i == 0 { buffer } else { buffer.push_back(',') };
            let buffer = Write::_string(buffer, member.@0).push_back(':');
            Write::_value(precision, buffer, member.@1)
        );
        buffer.push_back('}')
    );

    // Appends the elements of an array to `buffer`.
    //
    // # Parameters
    // * `precision` - How many places a number is written to.
    // * `buffer` - The buffer to append to.
    // * `elements` - The elements to write.
    _array : U8 -> Array U8 -> Array Json -> Array U8;
    _array = |precision, buffer, elements| (
        let size = elements.@size;
        let buffer = buffer.push_back('[');
        let buffer = range(0, size).fold(buffer, |i, buffer|
            let buffer = if i == 0 { buffer } else { buffer.push_back(',') };
            Write::_value(precision, buffer, elements.@(i))
        );
        buffer.push_back(']')
    );

    // Appends a string to `buffer`, in quotes, with the bytes JSON spells with an escape escaped.
    //
    // # Parameters
    // * `buffer` - The buffer to append to.
    // * `text` - The text to write.
    _string : Array U8 -> String -> Array U8;
    _string = |buffer, text| (
        let bytes = text.get_bytes;
        let size = bytes.@size - 1;
        let buffer = buffer.push_back('"');
        let buffer = range(0, size).fold(buffer, |i, buffer|
            let c = bytes.@(i);
            if c == '"' { buffer.push_back('\\').push_back('"') };
            if c == '\\' { buffer.push_back('\\').push_back('\\') };
            if c >= ' ' { buffer.push_back(c) };
            if c == 8_U8 { buffer._append("\\b") };
            if c == 12_U8 { buffer._append("\\f") };
            if c == '\n' { buffer._append("\\n") };
            if c == '\r' { buffer._append("\\r") };
            if c == '\t' { buffer._append("\\t") };
            buffer._append("\\u00")
                .push_back(_hex_digits.@(c.i64 / 16))
                .push_back(_hex_digits.@(c.i64 % 16))
        );
        buffer.push_back('"')
    );

    // The letters a hexadecimal digit is written with.
    _hex_digits : Array U8;
    _hex_digits = "0123456789abcdef".get_bytes;
}

namespace Number {
    // The number the bytes from `at` to `end` write.
    //
    // # Parameters
    // * `bytes` - The bytes to read from.
    // * `at` - The position of the number's first byte.
    // * `end` - One past the position of its last byte.
    parse : Array U8 -> I64 -> I64 -> Result ErrMsg F64;
    parse = |bytes, at, end| (
        let exact = _exact(bytes, at, end);
        if exact.is_some { ok $ exact.as_some };
        from_string(bytes.get_sub(at, end)._string_of)
    );

    // Appends `value` to `buffer`, written to `precision` places after the point with the zeros that
    // trail it dropped, and the point dropped with them where nothing is left behind it.
    //
    // # Parameters
    // * `precision` - How many places the number is written to.
    // * `buffer` - The buffer to append to.
    // * `value` - The number to write.
    append : U8 -> Array U8 -> F64 -> Array U8;
    append = |precision, buffer, value| (
        let places = precision.i64;
        if places >= _powers_of_ten.@size { _append_by_runtime(precision, buffer, value) };
        let unit = _powers_of_ten.@(places);
        let scale = unit.f64;
        let scaled = value * scale;
        // A number that is not below the bound, and one that is not a number at all, fail this test.
        if !(scaled > -_whole_bound && scaled < _whole_bound) {
            _append_by_runtime(precision, buffer, value)
        };
        let whole = (if scaled < 0.0 { scaled - 0.5 } else { scaled + 0.5 }).i64;
        // The digits of the whole number are the number's own digits at this precision exactly when
        // scaling it back answers with the number itself.
        if whole.f64 / scale != value { _append_by_runtime(precision, buffer, value) };
        _append_digits(buffer, unit, value._is_negative, whole)
    );

    // The number the bytes from `at` to `end` write, when they write one whose nearest double is a
    // whole number below `_mantissa_bound` scaled by a power of ten that a double holds exactly.
    //
    // # Parameters
    // * `bytes` - The bytes to read from.
    // * `at` - The position of the number's first byte.
    // * `end` - One past the position of its last byte.
    _exact : Array U8 -> I64 -> I64 -> Option F64;
    _exact = |bytes, at, end| (
        let negative = bytes.@(at) == '-';
        let start = if negative { at + 1 } else { at };
        // Every digit joins one whole number, and every digit behind the point lowers by one the power
        // of ten that number is scaled by. The walk stops early on a digit that would carry the whole
        // number past what a double holds exactly, which the test below then reads off the number.
        let (mantissa, scale, _, at) = loop((0, 0, false, start), |(mantissa, scale, behind, i)|
            if i >= end { break $ (mantissa, scale, behind, i) };
            let c = bytes.@(i);
            if c == '.' { continue $ (mantissa, scale, true, i + 1) };
            if c < '0' || c > '9' { break $ (mantissa, scale, behind, i) };
            if mantissa >= _mantissa_bound { break $ (mantissa, scale, behind, i) };
            continue $ (
                mantissa * 10 + (c - '0').i64, if behind { scale - 1 } else { scale }, behind, i + 1
            )
        );
        if mantissa >= _mantissa_bound { none() };
        let (scale, at) = _exponent(bytes, at, end, scale);
        if at != end { none() };
        if scale <= -_exact_powers_of_ten.@size || scale >= _exact_powers_of_ten.@size { none() };
        let value = if scale >= 0 {
            mantissa.f64 * _exact_powers_of_ten.@(scale)
        } else {
            mantissa.f64 / _exact_powers_of_ten.@(-scale)
        };
        some $ if negative { -value } else { value }
    );

    // The power of ten the digits ask for once the exponent behind `e` is taken in, and where reading
    // the exponent ends. Bytes that open with something else are left where they stand.
    //
    // # Parameters
    // * `bytes` - The bytes to read from.
    // * `at` - The position to read from.
    // * `end` - One past the position of the number's last byte.
    // * `scale` - The power of ten the digits ask for on their own.
    _exponent : Array U8 -> I64 -> I64 -> I64 -> (I64, I64);
    _exponent = |bytes, at, end, scale| (
        if at >= end { (scale, at) };
        let opener = bytes.@(at);
        if opener != 'e' && opener != 'E' { (scale, at) };
        let at = at + 1;
        if at >= end { (scale, at) };
        let sign = bytes.@(at);
        let negative = sign == '-';
        let at = if negative || sign == '+' { at + 1 } else { at };
        let (power, at) = loop((0, at), |(power, i)|
            if i >= end || power > _exact_powers_of_ten.@size { break $ (power, i) };
            let c = bytes.@(i);
            if c < '0' || c > '9' { break $ (power, i) };
            continue $ (power * 10 + (c - '0').i64, i + 1)
        );
        (if negative { scale - power } else { scale + power }, at)
    );

    // One past the largest whole number a double holds exactly.
    _mantissa_bound : I64;
    _mantissa_bound = 9007199254740992;

    // The bound below which the neighbours of a number stand more than one apart, so that rounding it
    // names one whole number and no other number rounds to the same one.
    _whole_bound : F64;
    _whole_bound = 4503599627370496.0;

    // The powers of ten that fit in an `I64`.
    _powers_of_ten : Array I64;
    _powers_of_ten = [
        1, 10, 100, 1000, 10000, 100000, 1000000, 10000000, 100000000, 1000000000,
        10000000000, 100000000000, 1000000000000, 10000000000000, 100000000000000,
        1000000000000000, 10000000000000000, 100000000000000000, 1000000000000000000
    ];

    // The powers of ten a double holds exactly.
    _exact_powers_of_ten : Array F64;
    _exact_powers_of_ten = [
        1.0, 10.0, 100.0, 1000.0, 10000.0, 100000.0, 1000000.0, 10000000.0, 100000000.0, 1000000000.0,
        10000000000.0, 100000000000.0, 1000000000000.0, 10000000000000.0, 100000000000000.0,
        1000000000000000.0, 10000000000000000.0, 100000000000000000.0, 1000000000000000000.0,
        10000000000000000000.0, 100000000000000000000.0, 1000000000000000000000.0,
        10000000000000000000000.0
    ];

    // Whether a number is written behind a minus sign, which zero is when it is the negative zero.
    //
    // # Parameters
    // * `value` - The number to test.
    _is_negative : F64 -> Bool;
    _is_negative = |value| value < 0.0 || (value == 0.0 && 1.0 / value < 0.0);

    // Appends the digits of `scaled` to `buffer`, with the point placed so that the digits behind it
    // stand for `1 / unit`, the zeros that trail it dropped, and the point dropped with them where
    // nothing is left behind it.
    //
    // # Parameters
    // * `buffer` - The buffer to append to.
    // * `unit` - The power of ten the number was scaled by.
    // * `negative` - Whether the number is written behind a minus sign.
    // * `scaled` - The number to write times `unit`.
    _append_digits : Array U8 -> I64 -> Bool -> I64 -> Array U8;
    _append_digits = |buffer, unit, negative, scaled| (
        let buffer = if negative { buffer.push_back('-') } else { buffer };
        let scaled = if scaled < 0 { -scaled } else { scaled };
        let buffer = _append_whole(buffer, scaled / unit);
        let fraction = scaled % unit;
        if fraction == 0 { buffer };
        // Dividing the zeros that trail the fraction away shrinks the unit with them, and the unit that
        // is left says how many places the digits that remain fill.
        let (fraction, unit) = loop((fraction, unit), |(fraction, unit)|
            if fraction % 10 == 0 { continue $ (fraction / 10, unit / 10) };
            break $ (fraction, unit)
        );
        _append_places(buffer.push_back('.'), unit / 10, fraction)
    );

    // Appends `value` to `buffer` as its own digits, of which there is at least one.
    //
    // # Parameters
    // * `buffer` - The buffer to append to.
    // * `value` - The number to write, which is not negative.
    _append_whole : Array U8 -> I64 -> Array U8;
    _append_whole = |buffer, value| (
        let top = loop((1), |place|
            if value / place < 10 { break $ place };
            continue $ place * 10
        );
        _append_places(buffer, top, value)
    );

    // Appends `value` to `buffer` as the digits from the place `top` down to the ones, so that a value
    // below `top` opens with as many zeros as it leaves places empty.
    //
    // # Parameters
    // * `buffer` - The buffer to append to.
    // * `top` - The place of the first digit, which is a power of ten.
    // * `value` - The number to write, which is below ten times `top`.
    _append_places : Array U8 -> I64 -> I64 -> Array U8;
    _append_places = |buffer, top, value| (
        loop((buffer, top), |(buffer, place)|
            let buffer = buffer.push_back('0' + ((value / place) % 10).u8);
            if place == 1 { break $ buffer };
            continue $ (buffer, place / 10)
        )
    );

    // Appends a number to `buffer` as the runtime's formatter writes it, with the zeros that trail it
    // dropped, and the point dropped with them where nothing is left behind it.
    //
    // # Parameters
    // * `precision` - How many places the number is written to.
    // * `buffer` - The buffer to append to.
    // * `value` - The number to write.
    _append_by_runtime : U8 -> Array U8 -> F64 -> Array U8;
    _append_by_runtime = |precision, buffer, value| (
        let text = value.to_string_precision(precision);
        let bytes = text.get_bytes;
        let size = bytes.@size - 1;
        let point = loop((0), |i|
            if i == size { break $ -1 };
            if bytes.@(i) == '.' { break $ i };
            continue $ i + 1
        );
        let end = if point < 0 { size } else {
            loop((size - 1), |i|
                if i < 1 { break $ i + 1 };
                if bytes.@(i) == '0' { continue $ i - 1 };
                if bytes.@(i) == '.' { break $ i };
                break $ i + 1
            )
        };
        range(0, end).fold(buffer, |i, buffer| buffer.push_back(bytes.@(i)))
    );
}

// A string made of the given bytes.
//
// # Parameters
// * `bytes` - The bytes of the string.
_string_of : Array U8 -> String;
_string_of = |bytes| bytes.push_back(0_U8).from_bytes.as_ok;
